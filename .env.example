# ---------- Required ----------
# Dashboard sign-in
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
# 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Where the dashboard is reachable (used in email links)
PUBLIC_BASE_URL=https://jobs.example.com
APP_TIMEZONE=Asia/Karachi
# Postgres in production. Leave unset locally to use SQLite in ./data/jobs.db
DATABASE_URL=postgresql://user:password@host:5432/jobs
# Only used by docker-compose.yml
POSTGRES_PASSWORD=

# ---------- Claude (AI analysis + daily summary) ----------
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the default. claude-haiku-5-5 cuts AI cost by roughly 40x.
CLAUDE_MODEL=claude-opus-5-5
ANALYSIS_EFFORT=low
# Prices used for the cost estimate on the Health page (USD per million tokens).
# Update both if you change CLAUDE_MODEL (Haiku 5.5: 0.10 / 0.50).
CLAUDE_INPUT_PRICE_PER_MTOK=4
CLAUDE_OUTPUT_PRICE_PER_MTOK=20
MAX_ANALYSES_PER_RUN=40

# ---------- Search ----------
# Serper.dev (Google results). Powers Google, LinkedIn, X, Facebook and Instagram coverage
# through site: queries. Strongly recommended.
SERPER_API_KEY=
SERPER_COST_PER_QUERY=0.001
# Alternative to Serper (used only if SERPER_API_KEY is empty)
BRAVE_API_KEY=
BRAVE_COST_PER_QUERY=0.005
# Optional: SerpApi Google Jobs (structured listings, 2 searches per run)
SERPAPI_API_KEY=
SERPAPI_COST_PER_QUERY=0.015
# Optional: official X API (paid plan) for direct X search
X_BEARER_TOKEN=
X_COST_PER_REQUEST=0
MAX_SEARCH_QUERIES_PER_RUN=18
MAX_ENRICH_FETCHES_PER_RUN=25

# ---------- Email ----------
# resend | smtp
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=GHL Job Hunter <alerts@yourdomain.com>
EMAIL_TO=you@example.com
# SMTP (if EMAIL_PROVIDER=smtp), e.g. Gmail with an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---------- Reliability ----------
# Dead-man's switch, e.g. a healthchecks.io check with a 2-hour grace period.
# The worker pings it after every run; if pings stop, healthchecks.io emails you
# even when the whole server is down.
HEALTHCHECK_PING_URL=
